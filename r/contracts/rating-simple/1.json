{
  "item": "rating-simple",
  "version": 1,
  "block": "block.ratingsimple",
  "organism": "RatingSimple",
  "line": "simple",
  "model": "rating@1",
  "modelSchema": "https://registry.buildy.tw/models/rating@1.schema.json",
  "axes": {
    "layout": [
      "bar",
      "centered"
    ]
  },
  "defaults": {
    "layout": "bar"
  },
  "variants": [
    {
      "id": "inline",
      "label": "A bar",
      "axes": {
        "layout": "bar"
      }
    },
    {
      "id": "centered",
      "label": "Centred",
      "axes": {
        "layout": "centered"
      }
    }
  ],
  "defaultVariant": "inline",
  "settings": {
    "level": {
      "type": "1 | 2 | 3",
      "default": 2
    },
    "padding": {
      "type": "\"compact\" | \"standard\" | \"spacious\"",
      "default": "standard"
    },
    "landmarkLabel": {
      "type": "string"
    }
  },
  "modes": [
    "wireframe"
  ],
  "defaultMode": "wireframe",
  "places": [
    {
      "place": "value",
      "kind": "text",
      "fields": [
        "/value"
      ]
    },
    {
      "place": "title",
      "kind": "heading",
      "fields": [
        "/title"
      ]
    },
    {
      "place": "description",
      "kind": "text",
      "fields": [
        "/description"
      ]
    },
    {
      "place": "sourceLabel",
      "kind": "text",
      "fields": [
        "/sourceLabel",
        "/sourceHref"
      ]
    }
  ],
  "wireframe": {
    "items": 3
  }
}
