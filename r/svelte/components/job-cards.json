      "content": "<!-- Code generated by xgen. DO NOT EDIT. -->\n<!-- Source: xgen/screens/src/authoring/components/people-parts.ts -->\n<!--\n  The jobs of JobBoard as cards in two columns (title, department, place, type, optional salary, posted, apply)\n  or as a table.\n-->\n<script lang=\"ts\" module>\n  import type { Snippet } from \"svelte\";\n  import type { Job, Department, JobLabels } from \"../blocks/job-board.types\";\n\n  export type JobCardsProps = {\n    jobs: Job[];\n    departments: Department[];\n    labels: JobLabels;\n    layout?: \"grid\" | \"grouped\" | \"table\";\n    salary?: \"show\" | \"hide\";\n  };\n</script>\n\n<script lang=\"ts\">\n  import Badge from \"../primitives/badge/badge.svelte\";\n  import Box from \"../primitives/box/box.svelte\";\n  import Grid from \"../primitives/grid/grid.svelte\";\n  import Group from \"../primitives/group/group.svelte\";\n  import Inline from \"../primitives/inline/inline.svelte\";\n  import Link from \"../primitives/link/link.svelte\";\n  import LucideIcon from \"../primitives/lucide-icon/lucide-icon.svelte\";\n  import Stack from \"../primitives/stack/stack.svelte\";\n  import Table from \"../primitives/table/table.svelte\";\n  import TableBody from \"../primitives/table/table-body.svelte\";\n  import TableCaption from \"../primitives/table/table-caption.svelte\";\n  import TableCell from \"../primitives/table/table-cell.svelte\";\n  import TableHead from \"../primitives/table/table-head.svelte\";\n  import TableHeadCell from \"../primitives/table/table-head-cell.svelte\";\n  import TableRow from \"../primitives/table/table-row.svelte\";\n  import Text from \"../primitives/text/text.svelte\";\n\n  let { jobs, departments, labels, layout = \"grid\", salary = \"hide\" }: JobCardsProps = $props();\n</script>\n\n{#if ((layout as string) === \"table\")}\n  <Box class=\"w-full overflow-x-auto rounded inset-ring inset-ring-border\">\n    <Table class=\"w-full text-left text-sm\" data-testid=\"job-table\">\n      <TableCaption class=\"sr-only\">\n        {labels.caption}\n      </TableCaption>\n      <TableHead class=\"bg-muted\">\n        <TableRow>\n          <TableHeadCell scope=\"col\" class=\"px-4 py-2\">\n            {labels.role}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"hidden py-2 md:table-cell\">\n            {labels.team}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"hidden py-2 sm:table-cell\">\n            {labels.location}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {labels.type}\n          </TableHeadCell>\n          {#if ((salary as string) === \"show\")}\n            <TableHeadCell scope=\"col\" class=\"hidden py-2 md:table-cell\">\n              {labels.salary}\n            </TableHeadCell>\n          {/if}\n          <TableHeadCell scope=\"col\" class=\"py-2 pr-4\">\n            <Inline class=\"sr-only\">\n              {labels.apply}\n            </Inline>\n          </TableHeadCell>\n        </TableRow>\n      </TableHead>\n      <TableBody>\n        {#each jobs as j (j.id)}\n          <TableRow class=\"border-t border-border\" data-testid=\"item\">\n            <TableCell class=\"px-4 py-4 font-medium\">\n              {j.title}\n            </TableCell>\n            <TableCell class=\"hidden md:table-cell\">\n              {departments.filter((i) => !j.dept || i[\"id\"] === j.dept)[0]?.name ?? \"\"}\n            </TableCell>\n            <TableCell class=\"hidden sm:table-cell\">\n              {j.location}\n            </TableCell>\n            <TableCell>\n              {j.type}\n            </TableCell>\n            {#if ((salary as string) === \"show\")}\n              <TableCell class=\"hidden md:table-cell\">\n                {j.salary}\n              </TableCell>\n            {/if}\n            <TableCell class=\"pr-4 text-right\">\n              <Link href=\"#/careers\" variant=\"default\" class=\"font-medium\">\n                {labels.apply}\n              </Link>\n            </TableCell>\n          </TableRow>\n        {/each}\n      </TableBody>\n    </Table>\n  </Box>\n{:else}\n  <Grid cols=\"1-2\" class=\"gap-4\" data-testid=\"items\">\n    {#each jobs as j (j.id)}\n      <Stack gap=\"4\" class=\"rounded bg-card inset-ring inset-ring-border p-6\" data-testid=\"item\">\n        <Stack gap=\"2\">\n          <Text size=\"lg\" weight=\"semibold\">\n            {j.title}\n          </Text>\n          <Group gap=\"4\" class=\"flex-wrap text-sm text-muted-foreground\">\n            <Group gap=\"2\" align=\"center\">\n              <LucideIcon name=\"briefcase\" size={16} />\n              <Inline>\n                {j.type}\n              </Inline>\n            </Group>\n            <Group gap=\"2\" align=\"center\">\n              <LucideIcon name=\"map-pin\" size={16} />\n              <Inline>\n                {j.location}\n              </Inline>\n            </Group>\n            <Group gap=\"2\" align=\"center\">\n              <LucideIcon name=\"calendar\" size={16} />\n              <Inline>\n                {j.posted}\n              </Inline>\n            </Group>\n          </Group>\n        </Stack>\n        {#if ((salary as string) === \"show\")}\n          <Text size=\"base\" weight=\"semibold\" data-testid=\"salary\">\n            {j.salary}\n          </Text>\n        {/if}\n        <Group gap=\"4\" align=\"center\" justify=\"between\" class=\"mt-auto\">\n          <Badge variant=\"secondary\" size=\"default\">\n            {departments.filter((i) => !j.dept || i[\"id\"] === j.dept)[0]?.name ?? \"\"}\n          </Badge>\n          <Link href=\"#/careers\" variant=\"default\" class=\"inline-flex items-center gap-2 text-sm font-medium\">\n            {labels.apply}\n            <LucideIcon name=\"arrow-right\" size={16} />\n          </Link>\n        </Group>\n      </Stack>\n    {/each}\n  </Grid>\n{/if}\n",
