      "content": "<!-- Code generated by xgen. DO NOT EDIT. -->\n<!-- Source: xgen/specs/ui/breadcrumb.json -->\n<!--\n  Breadcrumb renders the full navigation trail.\n-->\n<script lang=\"ts\" module>\n\n  export type BreadcrumbItem = {\n    label?: string;\n    href?: string;\n    current?: boolean;\n    disabled?: boolean;\n  };\n\n  export type BreadcrumbProps = {\n    items?: BreadcrumbItem[];\n    class?: string;\n    [key: string]: unknown;\n  };\n</script>\n\n<script lang=\"ts\">\n  import { cn } from \"../../utils\";\n  import { isSetStr, orUndef } from \"../../utils/expr\";\n\n  let {\n    items,\n    class: className,\n    ...rest\n  }: BreadcrumbProps = $props();\n\n  const cls = $derived(cn(\"text-sm\", className));\n</script>\n\n<nav {...(cls ? { class: cls } : {})} {...rest}>\n  <ol class=\"flex flex-wrap items-center gap-2\">\n    {#each items ?? [] as item}\n      <li class=\"inline-flex items-center\">\n        {#if (isSetStr(item.href) && !(item.disabled))}\n          <a\n            href={orUndef(item.href)}\n            class={cn(\n              \"text-sm\",\n              (\n                item.current ? \"font-medium\"\n                : item.disabled ? \"text-muted-foreground\"\n                : \"text-primary underline-offset-4 hover:underline\"\n              )\n            )}\n            aria-current={item.current ? \"page\" : undefined}\n          >{item.label}</a>\n        {:else}\n          <span\n            class={cn(\n              \"text-sm\",\n              (\n                item.current ? \"font-medium\"\n                : item.disabled ? \"text-muted-foreground\"\n                : \"text-primary underline-offset-4 hover:underline\"\n              )\n            )}\n            aria-current={item.current ? \"page\" : undefined}\n          >{item.label}</span>\n        {/if}\n      </li>\n    {/each}\n  </ol>\n</nav>\n",
