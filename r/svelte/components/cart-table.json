      "content": "<!-- Code generated by xgen. DO NOT EDIT. -->\n<!-- Source: xgen/screens/src/authoring/components/cart-table.ts -->\n<!--\n  The lines of a cart as a table (the table layout of CartList): product, price, quantity, line total and a\n  remove button.\n-->\n<script lang=\"ts\" module>\n  import type { Snippet } from \"svelte\";\n  import type { CartLine, CartLabels } from \"../blocks/cart-list.types\";\n\n  export type CartTableProps = {\n    lines: CartLine[];\n    labels: CartLabels;\n    media?: \"image\" | \"none\";\n    density?: \"default\" | \"compact\";\n    field?: string;\n    onremove?: (id: string) => void;\n  };\n</script>\n\n<script lang=\"ts\">\n  import Box from \"../primitives/box/box.svelte\";\n  import Button from \"../primitives/button/button.svelte\";\n  import Group from \"../primitives/group/group.svelte\";\n  import Inline from \"../primitives/inline/inline.svelte\";\n  import LucideIcon from \"../primitives/lucide-icon/lucide-icon.svelte\";\n  import Stack from \"../primitives/stack/stack.svelte\";\n  import Table from \"../primitives/table/table.svelte\";\n  import TableBody from \"../primitives/table/table-body.svelte\";\n  import TableCaption from \"../primitives/table/table-caption.svelte\";\n  import TableCell from \"../primitives/table/table-cell.svelte\";\n  import TableHead from \"../primitives/table/table-head.svelte\";\n  import TableHeadCell from \"../primitives/table/table-head-cell.svelte\";\n  import TableRow from \"../primitives/table/table-row.svelte\";\n  import Text from \"../primitives/text/text.svelte\";\n  import MediaFrame from \"../components/media-frame.svelte\";\n  import NumberField from \"../components/number-field.svelte\";\n  import { cn, fmtMoney, tpl } from \"../utils\";\n\n  let {\n    lines,\n    labels,\n    media = \"image\",\n    density = \"default\",\n    field = \"qty\",\n    onremove,\n  }: CartTableProps = $props();\n</script>\n\n<Box class=\"w-full overflow-x-auto\">\n  <Table class=\"w-full text-left text-sm\" data-testid=\"cart-table\">\n    <TableCaption class=\"sr-only\">\n      {labels.caption}\n    </TableCaption>\n    <TableHead>\n      <TableRow>\n        <TableHeadCell scope=\"col\" class=\"py-2\">\n          {labels.product}\n        </TableHeadCell>\n        <TableHeadCell scope=\"col\" class=\"hidden py-2 sm:table-cell\">\n          {labels.price}\n        </TableHeadCell>\n        <TableHeadCell scope=\"col\" class=\"py-2\">\n          {labels.qty}\n        </TableHeadCell>\n        <TableHeadCell scope=\"col\" class=\"py-2\">\n          {labels.total}\n        </TableHeadCell>\n        <TableHeadCell scope=\"col\" class=\"py-2\">\n          <Inline class=\"sr-only\">\n            {labels.remove}\n          </Inline>\n        </TableHeadCell>\n      </TableRow>\n    </TableHead>\n    <TableBody>\n      {#each lines as line (line.id)}\n        <TableRow class=\"border-t border-border\" data-testid=\"item\">\n          <TableCell class={cn((((density as string) === \"compact\") ? \"py-2\" : \"py-4\"))}>\n            <Group gap=\"4\" align=\"center\">\n              {#if ((media as string) === \"image\")}\n                <MediaFrame alt={line.name} ratio=\"1/1\" class=\"hidden size-14 shrink-0 sm:block\" />\n              {/if}\n              <Stack gap=\"0\">\n                <Text size=\"sm\" weight=\"semibold\">\n                  {line.name}\n                </Text>\n                <Text size=\"xs\" class=\"text-muted-foreground\">\n                  {line.variant}\n                </Text>\n              </Stack>\n            </Group>\n          </TableCell>\n          <TableCell class=\"hidden sm:table-cell\">\n            {fmtMoney(line.price, line.currency)}\n          </TableCell>\n          <TableCell>\n            <NumberField\n              value={(line.qty == null ? undefined : String(line.qty))}\n              name={tpl(\"{0}-{1}\", field, line.id)}\n              min=\"1\"\n              label={labels.qty}\n              decrease={labels.decrease}\n              increase={labels.increase}\n            />\n          </TableCell>\n          <TableCell class=\"font-semibold\">\n            {fmtMoney((line.price * line.qty), line.currency)}\n          </TableCell>\n          <TableCell class=\"text-right\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              layout=\"icon\"\n              aria-label={labels.remove}\n              data-testid=\"remove\"\n              onclick={() => onremove?.(line.id)}\n            >\n              <LucideIcon name=\"x\" size={16} />\n            </Button>\n          </TableCell>\n        </TableRow>\n      {/each}\n    </TableBody>\n  </Table>\n</Box>\n{#if ((lines?.length ?? 0) > 0)}\n  <Group\n    gap=\"4\"\n    align=\"center\"\n    justify=\"between\"\n    class=\"mt-4 flex-wrap border-t border-border pt-4\"\n    data-testid=\"cart-footer\"\n  >\n    <Text size=\"base\" weight=\"bold\" data-testid=\"subtotal\">\n      {labels.subtotal}\n      {\" \"}\n      {fmtMoney(lines.reduce((s, i) => s + i.price * i.qty, 0), lines[0]?.currency ?? \"\")}\n    </Text>\n    <Button variant=\"default\" size=\"default\" data-testid=\"checkout\">\n      {labels.checkout}\n    </Button>\n  </Group>\n{/if}\n",
