      "content": "<!-- Code generated by packages/kit-compose/src/organisms.ts from packages/compose-gen/specs (compose-gen organism emitters on kit-compose). DO NOT EDIT. -->\n<!--\n  Plans, or a product and its competitors, as three columns and the features as rows. A value of yes shows a\n  check, no a dash (both with a hidden word), anything else is shown as text. Axes: highlight (none, middle\n  column), tone, density.\n-->\n<script lang=\"ts\" module>\n  import type { Snippet } from \"svelte\";\n  import type { CompareRow, CompareLabels } from \"./comparison-table.types\";\n\n  export type ComparisonTableProps = {\n    id: string;\n    title: string;\n    rows: CompareRow[];\n    empty?: string;\n    labels: CompareLabels;\n    highlight?: \"none\" | \"middle\";\n    tone?: \"default\" | \"muted\";\n    density?: \"default\" | \"compact\";\n    landmarkLabel?: string;\n  };\n</script>\n\n<script lang=\"ts\">\n  import Box from \"../compose/Box.svelte\";\n  import Table from \"../compose/Table.svelte\";\n  import TableBody from \"../compose/TableBody.svelte\";\n  import TableCaption from \"../compose/TableCaption.svelte\";\n  import TableCell from \"../compose/TableCell.svelte\";\n  import TableHead from \"../compose/TableHead.svelte\";\n  import TableHeadCell from \"../compose/TableHeadCell.svelte\";\n  import TableRow from \"../compose/TableRow.svelte\";\n  import CompareMark from \"../components/compare-mark.svelte\";\n  import EmptyState from \"../components/empty-state.svelte\";\n  import SectionFrame from \"../components/section-frame.svelte\";\n  import { cn } from \"../utils\";\n\n  let {\n    id,\n    title,\n    rows,\n    empty = \"\",\n    labels,\n    highlight = \"none\",\n    tone = \"default\",\n    density = \"default\",\n    landmarkLabel,\n  }: ComparisonTableProps = $props();\n</script>\n\n<SectionFrame id={id} title={title} tone={tone} density={density} landmarkLabel={landmarkLabel}>\n  {#if ((rows?.length ?? 0) === 0)}\n    <EmptyState icon=\"table\" title={empty} />\n  {:else}\n    <Box class=\"relative w-full overflow-x-auto\">\n      <Table class=\"w-full text-left text-sm\" data-slot=\"compare\">\n        <TableCaption class=\"sr-only\">\n          {labels.caption}\n        </TableCaption>\n        <TableHead>\n          <TableRow>\n            <TableHeadCell scope=\"col\" class=\"py-4\">\n              {labels.feature}\n            </TableHeadCell>\n            <TableHeadCell scope=\"col\" class=\"py-4\">\n              {labels.a}\n            </TableHeadCell>\n            <TableHeadCell\n              scope=\"col\"\n              class={cn(\"py-4\", (((highlight as string) === \"middle\") ? \"bg-muted\" : \"\"))}\n              data-highlight={(((highlight as string) === \"middle\") ? \"true\" : \"false\")}\n            >\n              {labels.b}\n            </TableHeadCell>\n            <TableHeadCell scope=\"col\" class=\"py-4\">\n              {labels.c}\n            </TableHeadCell>\n          </TableRow>\n        </TableHead>\n        <TableBody>\n          {#each rows as row (row.id)}\n            <TableRow class=\"border-t border-border\" data-slot=\"item\">\n              <TableHeadCell scope=\"row\" class={cn(\"font-medium\", (((density as string) === \"compact\") ? \"py-2\" : \"py-4\"))}>\n                {row.label}\n              </TableHeadCell>\n              <TableCell class={cn((((density as string) === \"compact\") ? \"py-2\" : \"py-4\"))}>\n                <CompareMark value={row.a} yes={labels.yes} no={labels.no} />\n              </TableCell>\n              <TableCell\n                class={cn(\n                  (((density as string) === \"compact\") ? \"py-2\" : \"py-4\"),\n                  (((highlight as string) === \"middle\") ? \"bg-muted font-semibold\" : \"\")\n                )}\n              >\n                <CompareMark value={row.b} yes={labels.yes} no={labels.no} />\n              </TableCell>\n              <TableCell class={(((density as string) === \"compact\") ? \"py-2\" : \"py-4\")}>\n                <CompareMark value={row.c} yes={labels.yes} no={labels.no} />\n              </TableCell>\n            </TableRow>\n          {/each}\n        </TableBody>\n      </Table>\n    </Box>\n  {/if}\n</SectionFrame>\n",
