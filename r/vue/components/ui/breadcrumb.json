      "content": "<!-- Code generated by xgen. DO NOT EDIT. -->\n<!-- Source: xgen/specs/ui/breadcrumb.json -->\n<!--\n  Breadcrumb renders the full navigation trail.\n-->\n<script lang=\"ts\">\nexport type BreadcrumbItem = {\n  label?: string;\n  href?: string;\n  current?: boolean;\n  disabled?: boolean;\n};\n\nexport type BreadcrumbProps = {\n  items?: BreadcrumbItem[];\n  class?: string;\n};\n</script>\n\n<script setup lang=\"ts\">\nimport { computed, useAttrs } from \"vue\";\nimport { cn } from \"../../utils\";\nimport { isSetStr, orUndef } from \"../../utils/expr\";\n\ndefineOptions({ inheritAttrs: false });\nconst { items, class: className } = defineProps<BreadcrumbProps>();\nconst attrs = useAttrs();\nconst cls = computed(() => cn(\"text-sm\", className));\n</script>\n\n<template>\n  <nav :class=\"cls || undefined\" v-bind=\"attrs\">\n    <ol class=\"flex flex-wrap items-center gap-2\">\n      <li v-for=\"(item, i) in items ?? []\" :key=\"i\" class=\"inline-flex items-center\">\n        <template v-if=\"(isSetStr(item.href) && !(item.disabled))\">\n          <a\n            :href=\"orUndef(item.href)\"\n            :class=\"cn(\n              'text-sm',\n              (\n                item.current ? 'font-medium'\n                : item.disabled ? 'text-muted-foreground'\n                : 'text-primary underline-offset-4 hover:underline'\n              )\n            )\"\n            :aria-current=\"item.current ? 'page' : undefined\"\n          >{{ item.label }}</a>\n        </template>\n        <template v-else>\n          <span\n            :class=\"cn(\n              'text-sm',\n              (\n                item.current ? 'font-medium'\n                : item.disabled ? 'text-muted-foreground'\n                : 'text-primary underline-offset-4 hover:underline'\n              )\n            )\"\n            :aria-current=\"item.current ? 'page' : undefined\"\n          >{{ item.label }}</span>\n        </template>\n      </li>\n    </ol>\n  </nav>\n</template>\n",
