      "content": "<!-- Code generated by packages/kit-compose/src/organisms.ts from packages/compose-gen/specs (compose-gen organism emitters on kit-compose). DO NOT EDIT. -->\n<!--\n  The jobs of JobBoard as cards in two columns (title, department, place, type, optional salary, posted, apply)\n  or as a table.\n-->\n<script lang=\"ts\">\nimport type { Job, Department, JobLabels } from \"../blocks/job-board.types\";\n\nexport type JobCardsProps = {\n  jobs: Job[];\n  departments: Department[];\n  labels: JobLabels;\n  layout?: \"grid\" | \"grouped\" | \"table\";\n  salary?: \"show\" | \"hide\";\n};\n</script>\n\n<script setup lang=\"ts\">\nimport Badge from \"../compose/Badge.vue\";\nimport Box from \"../compose/Box.vue\";\nimport Grid from \"../compose/Grid.vue\";\nimport Group from \"../compose/Group.vue\";\nimport Inline from \"../compose/Inline.vue\";\nimport LucideIcon from \"../icons/LucideIcon.vue\";\nimport Stack from \"../compose/Stack.vue\";\nimport Table from \"../compose/Table.vue\";\nimport TableBody from \"../compose/TableBody.vue\";\nimport TableCaption from \"../compose/TableCaption.vue\";\nimport TableCell from \"../compose/TableCell.vue\";\nimport TableHead from \"../compose/TableHead.vue\";\nimport TableHeadCell from \"../compose/TableHeadCell.vue\";\nimport TableRow from \"../compose/TableRow.vue\";\nimport Text from \"../compose/Text.vue\";\nimport MenuEntry from \"../components/menu-entry.vue\";\n\nconst { jobs, departments, labels, layout = \"grid\", salary = \"hide\" } = defineProps<JobCardsProps>();\n</script>\n\n<template>\n  <Box\n    v-if=\"((layout as string) === 'table')\"\n    class=\"w-full overflow-x-auto rounded inset-ring inset-ring-border\"\n  >\n    <Table class=\"w-full text-left text-sm\" data-testid=\"job-table\">\n      <TableCaption class=\"sr-only\">\n        {{ labels.caption }}\n      </TableCaption>\n      <TableHead class=\"bg-muted\">\n        <TableRow>\n          <TableHeadCell scope=\"col\" class=\"px-4 py-2\">\n            {{ labels.role }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"hidden py-2 md:table-cell\">\n            {{ labels.team }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"hidden py-2 sm:table-cell\">\n            {{ labels.location }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.type }}\n          </TableHeadCell>\n          <TableHeadCell v-if=\"((salary as string) === 'show')\" scope=\"col\" class=\"hidden py-2 md:table-cell\">\n            {{ labels.salary }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2 pr-4\">\n            <Inline class=\"sr-only\">\n              {{ labels.apply }}\n            </Inline>\n          </TableHeadCell>\n        </TableRow>\n      </TableHead>\n      <TableBody>\n        <TableRow v-for=\"j in jobs\" :key=\"j.id\" class=\"border-t border-border\" data-testid=\"item\">\n          <TableCell class=\"px-4 py-4 font-medium\">\n            {{ j.title }}\n          </TableCell>\n          <TableCell class=\"hidden md:table-cell\">\n            {{ departments.filter((i) => !j.dept || i[\"id\"] === j.dept)[0]?.name ?? \"\" }}\n          </TableCell>\n          <TableCell class=\"hidden sm:table-cell\">\n            {{ j.location }}\n          </TableCell>\n          <TableCell>\n            {{ j.type }}\n          </TableCell>\n          <TableCell v-if=\"((salary as string) === 'show')\" class=\"hidden md:table-cell\">\n            {{ j.salary }}\n          </TableCell>\n          <TableCell class=\"pr-4 text-right\">\n            <MenuEntry :href=\"j.href\" class=\"font-medium\">\n              {{ labels.apply }}\n            </MenuEntry>\n          </TableCell>\n        </TableRow>\n      </TableBody>\n    </Table>\n  </Box>\n  <Grid v-else cols=\"1-2\" class=\"gap-4\" data-testid=\"items\">\n    <Stack\n      v-for=\"j in jobs\"\n      :key=\"j.id\"\n      gap=\"4\"\n      class=\"rounded bg-card inset-ring inset-ring-border p-6\"\n      data-testid=\"item\"\n    >\n      <Stack gap=\"2\">\n        <Text size=\"lg\" weight=\"semibold\">\n          {{ j.title }}\n        </Text>\n        <Group gap=\"4\" class=\"flex-wrap text-sm text-muted-foreground\">\n          <Group gap=\"2\" align=\"center\">\n            <LucideIcon name=\"briefcase\" :size=\"16\" />\n            <Inline>\n              {{ j.type }}\n            </Inline>\n          </Group>\n          <Group gap=\"2\" align=\"center\">\n            <LucideIcon name=\"map-pin\" :size=\"16\" />\n            <Inline>\n              {{ j.location }}\n            </Inline>\n          </Group>\n          <Group gap=\"2\" align=\"center\">\n            <LucideIcon name=\"calendar\" :size=\"16\" />\n            <Inline>\n              {{ j.posted }}\n            </Inline>\n          </Group>\n        </Group>\n      </Stack>\n      <Text v-if=\"((salary as string) === 'show')\" size=\"base\" weight=\"semibold\" data-testid=\"salary\">\n        {{ j.salary }}\n      </Text>\n      <Group gap=\"4\" align=\"center\" justify=\"between\" class=\"mt-auto\">\n        <Badge variant=\"secondary\" size=\"default\">\n          {{ departments.filter((i) => !j.dept || i[\"id\"] === j.dept)[0]?.name ?? \"\" }}\n        </Badge>\n        <MenuEntry :href=\"j.href\" class=\"inline-flex items-center gap-2 text-sm font-medium\">\n          {{ labels.apply }}\n          <LucideIcon name=\"arrow-right\" :size=\"16\" />\n        </MenuEntry>\n      </Group>\n    </Stack>\n  </Grid>\n</template>\n",
