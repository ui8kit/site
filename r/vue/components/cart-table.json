      "content": "<!-- Code generated by xgen. DO NOT EDIT. -->\n<!-- Source: xgen/screens/src/authoring/components/cart-table.ts -->\n<!--\n  The lines of a cart as a table (the table layout of CartList): product, price, quantity, line total and a\n  remove button.\n-->\n<script lang=\"ts\">\nimport type { CartLine, CartLabels } from \"../blocks/cart-list.types\";\n\nexport type CartTableProps = {\n  lines: CartLine[];\n  labels: CartLabels;\n  media?: \"image\" | \"none\";\n  density?: \"default\" | \"compact\";\n};\n</script>\n\n<script setup lang=\"ts\">\nimport Box from \"../primitives/box/box.vue\";\nimport Button from \"../primitives/button/button.vue\";\nimport Group from \"../primitives/group/group.vue\";\nimport Inline from \"../primitives/inline/inline.vue\";\nimport LucideIcon from \"../primitives/lucide-icon/lucide-icon.vue\";\nimport Stack from \"../primitives/stack/stack.vue\";\nimport Table from \"../primitives/table/table.vue\";\nimport TableBody from \"../primitives/table/table-body.vue\";\nimport TableCaption from \"../primitives/table/table-caption.vue\";\nimport TableCell from \"../primitives/table/table-cell.vue\";\nimport TableHead from \"../primitives/table/table-head.vue\";\nimport TableHeadCell from \"../primitives/table/table-head-cell.vue\";\nimport TableRow from \"../primitives/table/table-row.vue\";\nimport Text from \"../primitives/text/text.vue\";\nimport MediaFrame from \"../components/media-frame.vue\";\nimport NumberField from \"../components/number-field.vue\";\nimport { cn, fmtMoney } from \"../utils\";\n\nconst { lines, labels, media = \"image\", density = \"default\" } = defineProps<CartTableProps>();\nconst emit = defineEmits<{ remove: [id: string] }>();\n</script>\n\n<template>\n  <Box class=\"w-full overflow-x-auto\">\n    <Table class=\"w-full text-left text-sm\" data-testid=\"cart-table\">\n      <TableCaption class=\"sr-only\">\n        {{ labels.caption }}\n      </TableCaption>\n      <TableHead>\n        <TableRow>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.product }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"hidden py-2 sm:table-cell\">\n            {{ labels.price }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.qty }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.total }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            <Inline class=\"sr-only\">\n              {{ labels.remove }}\n            </Inline>\n          </TableHeadCell>\n        </TableRow>\n      </TableHead>\n      <TableBody>\n        <TableRow v-for=\"line in lines\" :key=\"line.id\" class=\"border-t border-border\" data-testid=\"item\">\n          <TableCell :class=\"cn((((density as string) === 'compact') ? 'py-2' : 'py-4'))\">\n            <Group gap=\"4\" align=\"center\">\n              <MediaFrame\n                v-if=\"((media as string) === 'image')\"\n                :alt=\"line.name\"\n                ratio=\"1/1\"\n                class=\"hidden size-14 shrink-0 sm:block\"\n              />\n              <Stack gap=\"0\">\n                <Text size=\"sm\" weight=\"semibold\">\n                  {{ line.name }}\n                </Text>\n                <Text size=\"xs\" class=\"text-muted-foreground\">\n                  {{ line.variant }}\n                </Text>\n              </Stack>\n            </Group>\n          </TableCell>\n          <TableCell class=\"hidden sm:table-cell\">\n            {{ fmtMoney(line.price, line.currency) }}\n          </TableCell>\n          <TableCell>\n            <NumberField\n              :value=\"(line.qty == null ? undefined : String(line.qty))\"\n              name=\"qty\"\n              min=\"1\"\n              :label=\"labels.qty\"\n              :decrease=\"labels.decrease\"\n              :increase=\"labels.increase\"\n            />\n          </TableCell>\n          <TableCell class=\"font-semibold\">\n            {{ fmtMoney((line.price * line.qty), line.currency) }}\n          </TableCell>\n          <TableCell class=\"text-right\">\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              layout=\"icon\"\n              :aria-label=\"labels.remove\"\n              data-testid=\"remove\"\n              @click=\"() => emit('remove', line.id)\"\n            >\n              <LucideIcon name=\"x\" :size=\"16\" />\n            </Button>\n          </TableCell>\n        </TableRow>\n      </TableBody>\n    </Table>\n  </Box>\n  <Group v-if=\"((lines?.length ?? 0) > 0)\"\n    gap=\"4\"\n    align=\"center\"\n    justify=\"between\"\n    class=\"mt-4 flex-wrap border-t border-border pt-4\"\n    data-testid=\"cart-footer\"\n  >\n    <Text size=\"base\" weight=\"bold\" data-testid=\"subtotal\">\n      {{ labels.subtotal }}\n      {{ \" \" }}\n      {{ fmtMoney(lines.reduce((s, i) => s + i.price * i.qty, 0), lines[0]?.currency ?? \"\") }}\n    </Text>\n    <Button variant=\"default\" size=\"default\" data-testid=\"checkout\">\n      {{ labels.checkout }}\n    </Button>\n  </Group>\n</template>\n",
