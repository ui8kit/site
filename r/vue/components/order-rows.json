      "content": "<!-- Code generated by xgen. DO NOT EDIT. -->\n<!-- Source: xgen/screens/src/authoring/components/orders.ts -->\n<!-- The orders as a table (the table layout of OrderTable): number, date, items, total and a status pill. -->\n<script lang=\"ts\">\nimport type { Order, OrderLabels } from \"../blocks/order-table.types\";\n\nexport type OrderRowsProps = {\n  orders: Order[];\n  statuses: Record<string, string>;\n  labels: OrderLabels;\n  density?: \"default\" | \"compact\";\n};\n</script>\n\n<script setup lang=\"ts\">\nimport Box from \"../primitives/box/box.vue\";\nimport Table from \"../primitives/table/table.vue\";\nimport TableBody from \"../primitives/table/table-body.vue\";\nimport TableCaption from \"../primitives/table/table-caption.vue\";\nimport TableCell from \"../primitives/table/table-cell.vue\";\nimport TableHead from \"../primitives/table/table-head.vue\";\nimport TableHeadCell from \"../primitives/table/table-head-cell.vue\";\nimport TableRow from \"../primitives/table/table-row.vue\";\nimport Pill from \"../components/pill.vue\";\nimport { at, cn, fmtMoney, tpl } from \"../utils\";\n\nconst { orders, statuses, labels, density = \"default\" } = defineProps<OrderRowsProps>();\n</script>\n\n<template>\n  <Box class=\"w-full overflow-x-auto\">\n    <Table class=\"w-full text-left text-sm\" data-testid=\"order-table\">\n      <TableCaption class=\"sr-only\">\n        {{ labels.caption }}\n      </TableCaption>\n      <TableHead>\n        <TableRow>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.number }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.date }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.items }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.total }}\n          </TableHeadCell>\n          <TableHeadCell scope=\"col\" class=\"py-2\">\n            {{ labels.status }}\n          </TableHeadCell>\n        </TableRow>\n      </TableHead>\n      <TableBody>\n        <TableRow v-for=\"o in orders\" :key=\"o.id\" class=\"border-t border-border\" data-testid=\"item\">\n          <TableCell :class=\"cn('font-semibold', (((density as string) === 'compact') ? 'py-2' : 'py-4'))\">\n            {{ o.number }}\n          </TableCell>\n          <TableCell>\n            {{ o.date }}\n          </TableCell>\n          <TableCell>\n            {{ tpl(labels.itemsCount, o.items) }}\n          </TableCell>\n          <TableCell>\n            {{ fmtMoney(o.total, o.currency) }}\n          </TableCell>\n          <TableCell>\n            <Pill\n              :tone=\"\n                o.status === 'paid' ? 'green'\n                : o.status === 'shipped' ? 'blue'\n                : o.status === 'pending' ? 'amber'\n                : 'gray'\n              \"\n            >\n              {{ at(statuses, o.status) }}\n            </Pill>\n          </TableCell>\n        </TableRow>\n      </TableBody>\n    </Table>\n  </Box>\n</template>\n",
