{
  "name": "ui8kit-site",
  "private": true,
  "version": "0.1.0",
  "description": "ui8kit monorepo: registry (r/), registry tooling, docs content and the static site generator",
  "license": "MIT",
  "ui8kit": {
    "runtime": "templ",
    "generated": false,
    "kit": ["generator/ui8kit"],
    "composition": ["generator/templates"],
    "blockRoot": ["generator/templates/home.templ", "generator/templates/docs-index.templ", "generator/templates/doc.templ", "generator/templates/item.templ", "generator/templates/templates-index.templ", "generator/templates/template-app.templ", "generator/templates/template-page.templ", "generator/templates/home-hero.templ", "generator/templates/home-counts.templ", "generator/templates/home-cards.templ"]
  },
  "workspaces": [
    "registry"
  ],
  "scripts": {
    "registry:build": "bun run --cwd registry build",
    "registry:validate": "bun run --cwd registry validate",
    "previews:build": "bun run registry/src/previews.ts",
    "site:generate": "cd generator && go run . --registry ../r --content ../content --out ../dist",
    "docs:build": "bash scripts/build-docs.sh",
    "site:build": "bun run registry:build && bun run registry:validate && bun run site:generate",
    "site:css": "tailwindcss -i generator/assets/site.src.css -o generator/assets/site.css --minify",
    "site:templ": "cd generator && templ generate",
    "site:sync-ui8kit": "bash scripts/sync-ui8kit-templ.sh",
    "site:rules": "bun scripts/check-rules.ts",
    "templates:build": "bun run registry/src/templates.ts",
    "static-code:build": "bun run registry/src/static-code.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "axe-core": "^4.14.0",
    "puppeteer-core": "^25.13.0",
    "tailwindcss": "^4.3.3"
  }
}
