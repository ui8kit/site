{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://registry.buildy.tw/schema/registry-item.json",
  "title": "UI8Kit Registry Item",
  "type": "object",
  "required": [
    "name",
    "type",
    "files"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:lib",
        "registry:utils",
        "registry:ui",
        "registry:component",
        "registry:composite",
        "registry:block",
        "registry:layout",
        "registry:variants",
        "registry:widget",
        "registry:rules",
        "registry:theme"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "runtime": {
      "type": "string"
    },
    "digest": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "devDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
