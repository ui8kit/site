package templates

import (
	"fmt"

	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/block"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/box"
	linkplain "github.com/codegen-x/ui8kit/packages/templ/ui/ui/link-plain"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/table"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/text"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/title"
)

const cell = "px-0 py-2 pr-4"

templ HomeCounts(d HomeData) {
	@block.Block(block.BlockProps{Tag: "section", Class: "py-8", Attrs: templ.Attributes{"aria-labelledby": "counts"}}) {
		@title.Title(title.TitleProps{As: 2, Size: "2xl", Class: "mb-4", Attrs: templ.Attributes{"id": "counts"}}) {
			{ T("home.counts") }
		}
		@box.Box(box.BoxProps{Class: "overflow-x-auto"}) {
			@table.Table(table.TableProps{Class: "w-full text-left text-sm"}) {
				@table.TableCaption(table.TableCaptionProps{Class: "sr-only"}) {
					{ T("home.countsCaption") }
				}
				@table.TableHead(table.TableHeadProps{}) {
					@table.TableRow(table.TableRowProps{Class: "border-b border-border"}) {
						for _, k := range []string{"home.colRuntime", "home.colPrimitives", "home.colComponents", "home.colBlocks"} {
							@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: cell + " font-medium"}) {
								{ T(k) }
							}
						}
						@table.TableHeadCell(table.TableHeadCellProps{Scope: "col", Class: "px-0 py-2 font-medium"}) {
							{ T("home.colUrl") }
						}
					}
				}
				@table.TableBody(table.TableBodyProps{}) {
					for _, c := range d.Counts {
						@table.TableRow(table.TableRowProps{Class: "border-b border-border"}) {
							@table.TableHeadCell(table.TableHeadCellProps{Scope: "row", Class: cell + " font-medium"}) {
								{ c.Runtime }
							}
							@table.TableCell(table.TableCellProps{Class: cell}) {
								{ fmt.Sprint(c.Primitives) }
							}
							@table.TableCell(table.TableCellProps{Class: cell}) {
								{ fmt.Sprint(c.Components) }
							}
							@table.TableCell(table.TableCellProps{Class: cell}) {
								{ fmt.Sprint(c.Blocks) }
							}
							@table.TableCell(table.TableCellProps{Class: "px-0 py-2"}) {
								@linkplain.LinkPlain(linkplain.LinkPlainProps{Href: d.RegistryBase + "/" + c.Runtime + "/index.json", Class: "underline"}) {
									{ d.RegistryBase + "/" + c.Runtime }
								}
							}
						}
					}
				}
			}
		}
		@text.Text(text.TextProps{Size: "sm", Class: "mt-4 text-muted-foreground"}) {
			{ Tf("home.commit", d.Commit) }
		}
	}
}
