package templates

import (
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/box"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/text"
)

// Preview: the static HTML of a block or page sample, rendered at build time (raw-html, recorded), in a scrolling frame.
// dirPreview: the root takes the header's preview direction (data-dir-preview; theme.js sets dir="ltr" | "rtl" on it).
templ Preview(html string, label string, padded bool, empty string, dirPreview bool) {
	if html != "" {
		@box.Box(box.BoxProps{Class: previewClass(padded), Attrs: previewAttrs(label, dirPreview)}) {
			@templ.Raw(html)
		}
	} else {
		@text.Text(text.TextProps{Size: "sm", Class: "mb-8 text-muted-foreground"}) {
			{ empty }
		}
	}
}

func previewClass(padded bool) string {
	if padded {
		return "preview mb-8 rounded border border-border bg-background p-6"
	}
	return "preview mb-8 rounded border border-border bg-background"
}

func previewAttrs(label string, dirPreview bool) templ.Attributes {
	a := templ.Attributes{"role": "group", "tabindex": "0", "aria-label": label}
	if dirPreview {
		a["data-dir-preview"] = true
	}
	return a
}
