package templates

import (
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/box"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/label"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/radio"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/text"
)

// CodePanels: one panel per runtime, switched without JS by radio inputs (CSS :has in site.src.css, .rt).
// The code is HTML that chroma highlights at build time (raw-html, recorded).
templ CodePanels(panels []RuntimePanel, intro string, json bool) {
	@box.Box(box.BoxProps{Class: "rt mb-8"}) {
		@box.Box(box.BoxProps{Class: "rt-bar", Attrs: templ.Attributes{"role": "radiogroup", "aria-label": T("code.runtime")}}) {
			for i, p := range panels {
				@radio.Radio(radio.RadioProps{ID: "rt-" + p.Runtime, Name: "rt", Value: p.Runtime, Checked: i == 0, Class: "sr-only size-px"})
				@label.Label(label.LabelProps{HTMLFor: "rt-" + p.Runtime}) {
					{ p.Label }
				}
			}
		}
		for _, p := range panels {
			@RuntimePanelView(p, intro, json)
		}
	}
}

templ CodeFileView(f CodeFile) {
	@box.Box(box.BoxProps{Class: "mb-4"}) {
		@box.Box(box.BoxProps{Class: "flex items-center justify-between gap-4 rounded-t border border-border bg-muted px-4 py-2"}) {
			@text.Text(text.TextProps{Tag: "span", Class: "font-mono text-xs"}) {
				{ f.Name }
			}
			@CopyButton(f.ID)
		}
		@text.Text(text.TextProps{Tag: "pre", Class: "hl max-h-[32rem] overflow-auto rounded-b border border-t-0 border-border bg-card p-4 text-xs leading-6", Attrs: templ.Attributes{"tabindex": "0"}}) {
			@text.Text(text.TextProps{Tag: "code", Class: "font-mono", Attrs: templ.Attributes{"id": f.ID}}) {
				@templ.Raw(f.HTML)
			}
		}
	}
}
