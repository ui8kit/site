package templates

import (
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/box"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/text"
)

// Command: one shell command with its copy button.
templ Command(id string, cmd string) {
	@box.Box(box.BoxProps{Class: "flex items-center justify-between gap-4 rounded border border-border bg-muted px-4 py-2"}) {
		@text.Text(text.TextProps{Tag: "code", Class: "overflow-x-auto whitespace-nowrap font-mono text-sm", Attrs: templ.Attributes{"id": id, "tabindex": "0"}}) {
			{ cmd }
		}
		@CopyButton(id)
	}
}
