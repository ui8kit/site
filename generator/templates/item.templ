package templates

import (
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/block"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/box"
	linkplain "github.com/codegen-x/ui8kit/packages/templ/ui/ui/link-plain"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/list"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/text"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/title"
)

// Item: one registry item. The preview is static HTML rendered at build time (raw-html, recorded).
templ Item(d ItemData) {
	@block.Block(block.BlockProps{Tag: "article"}) {
		@text.Text(text.TextProps{Size: "sm", Class: "text-muted-foreground"}) {
			@linkplain.LinkPlain(linkplain.LinkPlainProps{Href: d.CategoryHref, Class: "underline"}) {
				{ d.Kind + T("slash") + d.Category }
			}
		}
		@title.Title(title.TitleProps{As: 1, Size: "3xl", Class: "mb-2 tracking-tight"}) {
			{ d.Title }
		}
		@text.Text(text.TextProps{Class: "mb-6 max-w-3xl text-muted-foreground"}) {
			{ d.Description }
		}
		@SectionTitle(T("item.install"))
		@box.Box(box.BoxProps{Class: "mb-6 max-w-xl"}) {
			@Command("install-"+d.Name, d.Install)
		}
		if len(d.Requires) > 0 {
			@RelatedLinks(T("item.pulls"), d.Requires, "mb-6")
		}
		@SectionTitle(T("item.preview"))
		@Preview(d.Preview, Tf("item.previewOf", d.Title), d.Kind != "block", T("item.noPreview"))
		@SectionTitle(T("item.code"))
		@CodePanels(d.Panels, T("item.cliIntro"), true)
		@SectionTitle(T("item.props"))
		@text.Text(text.TextProps{Size: "sm", Class: "mb-4 max-w-3xl text-muted-foreground"}) {
			{ T("item.propsLead") }
		}
		if len(d.PropTables) == 0 {
			@text.Text(text.TextProps{Size: "sm", Class: "mb-8 text-muted-foreground"}) {
				{ T("item.noProps") }
			}
		}
		for _, t := range d.PropTables {
			@PropsTable(t, len(d.PropTables) == 1)
		}
		if len(d.UsedIn) > 0 {
			@SectionTitle(T("item.usedIn"))
			@list.List(list.ListProps{Class: "flex flex-wrap gap-x-4 gap-y-1 text-sm"}) {
				for _, r := range d.UsedIn {
					@list.ListItem(list.ListItemProps{}) {
						@linkplain.LinkPlain(linkplain.LinkPlainProps{Href: r.Href, Class: "underline"}) {
							{ r.Name }
						}
					}
				}
			}
		}
	}
}
