package templates

import "fmt"

templ CopyButton(target string) {
	<button type="button" hidden data-copy={ target } class="h-8 rounded border border-input bg-card px-3 text-xs font-medium hover:bg-accent">Copy</button>
}

templ Command(id string, cmd string) {
	<div class="flex items-center justify-between gap-4 rounded border border-border bg-muted px-4 py-2">
		<code id={ id } tabindex="0" class="overflow-x-auto whitespace-nowrap font-mono text-sm">{ cmd }</code>
		@CopyButton(id)
	</div>
}

templ CardList(items []Card) {
	<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		for _, c := range items {
			<li class="rounded border border-border bg-card p-4">
				<h3 class="text-base font-semibold"><a class="hover:underline" href={ templ.SafeURL(c.Href) }>{ c.Title }</a></h3>
				if c.HasTag() {
					<p class="text-xs text-muted-foreground">{ c.Tag }</p>
				}
				<p class="mt-2 text-sm text-muted-foreground">{ c.Description }</p>
			</li>
		}
	</ul>
}

templ Home(d HomeData) {
	<section class="flex flex-col gap-6 py-8">
		<p class="text-sm font-medium text-muted-foreground">Registry v{ d.Version }: Svelte, React and Vue</p>
		<h1 class="text-4xl font-semibold tracking-tight">Blocks and primitives you copy into your app</h1>
		<p class="max-w-2xl text-lg text-muted-foreground">Read the code, copy it, or install it with the CLI. Every item ships as source for Svelte, React and Vue on an 8px grid with shadcn tokens.</p>
		<div class="max-w-xl">
			@Command("home-install", "npx ui8kit add hero-split")
		</div>
		<div class="flex gap-4">
			<a href="/docs/getting-started/" class="inline-flex h-10 items-center rounded bg-primary px-4 text-sm font-medium text-primary-foreground">Get started</a>
			<a href="/docs/" class="inline-flex h-10 items-center rounded bg-card px-4 text-sm font-medium inset-ring inset-ring-border">Browse docs</a>
		</div>
	</section>
	<section aria-labelledby="counts" class="py-8">
		<h2 id="counts" class="mb-4 text-2xl font-semibold">What is in the registry</h2>
		<div class="overflow-x-auto">
			<table class="w-full text-left text-sm">
				<caption class="sr-only">Items per runtime</caption>
				<thead>
					<tr class="border-b border-border">
						<th scope="col" class="py-2 pr-4 font-medium">Runtime</th>
						<th scope="col" class="py-2 pr-4 font-medium">Primitives</th>
						<th scope="col" class="py-2 pr-4 font-medium">Components</th>
						<th scope="col" class="py-2 pr-4 font-medium">Blocks</th>
						<th scope="col" class="py-2 font-medium">Registry URL</th>
					</tr>
				</thead>
				<tbody>
					for _, c := range d.Counts {
						<tr class="border-b border-border">
							<th scope="row" class="py-2 pr-4 font-medium">{ c.Runtime }</th>
							<td class="py-2 pr-4">{ fmt.Sprint(c.Primitives) }</td>
							<td class="py-2 pr-4">{ fmt.Sprint(c.Components) }</td>
							<td class="py-2 pr-4">{ fmt.Sprint(c.Blocks) }</td>
							<td class="py-2"><a class="underline" href={ templ.SafeURL(d.RegistryBase + "/" + c.Runtime + "/index.json") }>{ d.RegistryBase + "/" + c.Runtime }</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class="mt-4 text-sm text-muted-foreground">Built from source commit { d.Commit }.</p>
	</section>
	<section aria-labelledby="blocks" class="py-8">
		<h2 id="blocks" class="mb-4 text-2xl font-semibold">Blocks</h2>
		@CardList(d.Blocks)
	</section>
	<section aria-labelledby="prims" class="py-8">
		<h2 id="prims" class="mb-4 text-2xl font-semibold">Primitives</h2>
		@CardList(d.Primitives)
	</section>
}

templ DocsIndex(d DocsIndexData) {
	<h1 class="mb-4 text-3xl font-semibold tracking-tight">Documentation</h1>
	<p class="mb-8 max-w-2xl text-muted-foreground">Guides first, then one page per category of the registry.</p>
	<h2 class="mb-4 text-xl font-semibold">Guides</h2>
	@CardList(d.Guides)
	<h2 class="mb-4 mt-8 text-xl font-semibold">Categories</h2>
	@CardList(d.Categories)
}

templ Doc(d DocData) {
	<article class="max-w-3xl">
		<h1 class="mb-4 text-3xl font-semibold tracking-tight">{ d.Title }</h1>
		<div class="prose-ui flex flex-col gap-4 text-base leading-8 [&_a]:underline [&_h2]:mt-8 [&_h2]:text-2xl [&_h2]:font-semibold [&_h3]:mt-4 [&_h3]:text-lg [&_h3]:font-semibold [&_pre]:overflow-x-auto [&_pre]:rounded [&_pre]:bg-muted [&_pre]:p-4 [&_pre]:text-sm [&_code]:font-mono [&_code]:text-sm [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_table]:w-full [&_table]:text-sm [&_th]:border-b [&_th]:border-border [&_th]:py-2 [&_th]:text-left [&_td]:border-b [&_td]:border-border [&_td]:py-2">
			@templ.Raw(d.HTML)
		</div>
		if len(d.Items) > 0 {
			<h2 class="mb-4 mt-8 text-2xl font-semibold">Items</h2>
			@CardList(d.Items)
		}
	</article>
}

templ PropsTable(t PropTable, single bool) {
	<div class="mb-8">
		if !single {
			<h3 class="mb-2 font-mono text-base font-semibold">{ t.Part }</h3>
		}
		if t.Docs != "" {
			<p class="mb-2 max-w-3xl whitespace-pre-line text-sm text-muted-foreground">{ t.Docs }</p>
		}
		if len(t.Rows) == 0 {
			<p class="text-sm text-muted-foreground">No props.</p>
		} else {
			<div class="overflow-x-auto" tabindex="0" role="region" aria-label={ "Props of " + t.Part }>
				<table class="w-full min-w-[40rem] text-left text-sm">
					<caption class="sr-only">{ "Props of " + t.Part }</caption>
					<thead>
						<tr class="border-b border-border">
							<th scope="col" class="py-2 pr-4 font-medium">Prop</th>
							<th scope="col" class="py-2 pr-4 font-medium">Type</th>
							<th scope="col" class="py-2 pr-4 font-medium">Default</th>
							<th scope="col" class="py-2 font-medium">Description</th>
						</tr>
					</thead>
					<tbody>
						for _, r := range t.Rows {
							<tr class="border-b border-border align-top">
								<th scope="row" class="py-2 pr-4 font-mono text-xs font-medium">
									{ r.Name }
									if r.Required {
										<span class="font-sans text-muted-foreground"> (required)</span>
									}
								</th>
								<td class="py-2 pr-4 font-mono text-xs">{ r.Type }</td>
								<td class="py-2 pr-4 font-mono text-xs">
									if r.Default != "" {
										{ r.Default }
									} else {
										<span class="text-muted-foreground">-</span>
									}
								</td>
								<td class="py-2 text-muted-foreground">{ r.Desc }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ Item(d ItemData) {
	<article>
		<p class="text-sm text-muted-foreground"><a class="underline" href={ templ.SafeURL(d.CategoryHref) }>{ d.Kind } / { d.Category }</a></p>
		<h1 class="mb-2 text-3xl font-semibold tracking-tight">{ d.Title }</h1>
		<p class="mb-6 max-w-3xl text-muted-foreground">{ d.Description }</p>
		<h2 class="mb-2 text-xl font-semibold">Install</h2>
		<div class="mb-6 max-w-xl">
			@Command("install-"+d.Name, d.Install)
		</div>
		if len(d.Requires) > 0 {
			<p class="mb-6 text-sm text-muted-foreground">
				Pulls in:
				for i, r := range d.Requires {
					if i > 0 {
						<span>, </span>
					}
					<a class="underline" href={ templ.SafeURL(r.Href) }>{ r.Name }</a>
				}
			</p>
		}
		<h2 class="mb-2 text-xl font-semibold">Preview</h2>
		if d.Preview != "" {
			<div class={ "preview mb-8 rounded border border-border bg-background", templ.KV("p-6", d.Kind != "block") } role="group" tabindex="0" aria-label={ d.Title + " preview" }>
				@templ.Raw(d.Preview)
			</div>
		} else {
			<p class="mb-8 text-sm text-muted-foreground">No static preview for this item: it needs content or a parent that this page cannot supply. The code is below.</p>
		}
		<h2 class="mb-2 text-xl font-semibold">Code</h2>
		<div class="rt mb-8">
			<div class="rt-bar" role="radiogroup" aria-label="Runtime">
				for i, p := range d.Panels {
					<input type="radio" name="rt" id={ "rt-" + p.Runtime } value={ p.Runtime } class="sr-only" checked?={ i == 0 }/>
					<label for={ "rt-" + p.Runtime }>{ p.Label }</label>
				}
			</div>
			for _, p := range d.Panels {
				<section id={ p.ID } class="rt-panel" data-runtime={ p.Runtime } aria-label={ p.Label + " code" }>
					<p class="mb-2 text-sm text-muted-foreground">Point the CLI at this runtime once, then add the item:</p>
					<div class="mb-2">
						@Command(p.ID+"-init", p.InstallInit)
					</div>
					<div class="mb-4">
						@Command(p.ID+"-add", p.InstallAdd)
					</div>
					for _, f := range p.Files {
						<div class="mb-4">
							<div class="flex items-center justify-between gap-4 rounded-t border border-border bg-muted px-4 py-2">
								<span class="font-mono text-xs">{ f.Name }</span>
								@CopyButton(f.ID)
							</div>
							<pre tabindex="0" class="hl max-h-[32rem] overflow-auto rounded-b border border-t-0 border-border bg-card p-4 text-xs leading-6"><code id={ f.ID } class="font-mono">@templ.Raw(f.HTML)</code></pre>
						</div>
					}
					<p class="text-sm"><a class="underline" href={ templ.SafeURL(p.JSONHref) }>{ p.Label } registry item (JSON)</a></p>
				</section>
			}
		</div>
		<h2 class="mb-2 text-xl font-semibold">Props</h2>
		<p class="mb-4 max-w-3xl text-sm text-muted-foreground">Names and types come from the xgen specs of the source. Standard HTML attributes (id, role, tabIndex, aria-*) pass through to the root element; the class prop is className in React.</p>
		if len(d.PropTables) == 0 {
			<p class="mb-8 text-sm text-muted-foreground">No props data for this item.</p>
		}
		for _, t := range d.PropTables {
			@PropsTable(t, len(d.PropTables) == 1)
		}
		if len(d.UsedIn) > 0 {
			<h2 class="mb-2 text-xl font-semibold">Used in</h2>
			<ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
				for _, r := range d.UsedIn {
					<li><a class="underline" href={ templ.SafeURL(r.Href) }>{ r.Name }</a></li>
				}
			</ul>
		}
	</article>
}
