package templates

// The document shell: html, head and body have no primitive (the kit renders inside body), so this file is outside the
// composition rules' Block-root zone; its raw tags are recorded in rules-baseline.json.

templ Layout(m Meta) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ m.Title }</title>
			<meta name="description" content={ m.Description }/>
			<link rel="canonical" href={ m.SiteURL + m.Path }/>
			<script src="/assets/theme.js"></script>
			<link rel="stylesheet" href="/assets/site.css"/>
			<link rel="stylesheet" href="/assets/skins.css"/>
			<script src="/assets/app.js" defer></script>
		</head>
		<body class="min-h-screen bg-background text-foreground font-sans">
			@SiteFrame(m) {
				{ children... }
			}
		</body>
	</html>
}
