package templates

import (
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/block"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/box"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/button"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/text"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/title"
)

templ HomeHero(d HomeData) {
	@block.Block(block.BlockProps{Tag: "section", Class: "flex flex-col gap-6 py-8"}) {
		@text.Text(text.TextProps{Size: "sm", Weight: "medium", Class: "text-muted-foreground"}) {
			{ Tf("home.eyebrow", d.Version) }
		}
		@title.Title(title.TitleProps{As: 1, Size: "4xl", Class: "tracking-tight"}) {
			{ T("home.title") }
		}
		@text.Text(text.TextProps{Size: "lg", Class: "max-w-2xl text-muted-foreground"}) {
			{ T("home.lead") }
		}
		@box.Box(box.BoxProps{Class: "max-w-xl"}) {
			@Command("home-install", "npx ui8kit add hero-split")
		}
		@box.Box(box.BoxProps{Class: "flex gap-4"}) {
			@button.Button(button.ButtonProps{Href: "/docs/getting-started/"}) {
				{ T("home.start") }
			}
			@button.Button(button.ButtonProps{Href: "/docs/", Variant: "outline"}) {
				{ T("home.browse") }
			}
		}
	}
}
