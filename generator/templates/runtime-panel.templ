package templates

import (
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/block"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/box"
	linkplain "github.com/codegen-x/ui8kit/packages/templ/ui/ui/link-plain"
	"github.com/codegen-x/ui8kit/packages/templ/ui/ui/text"
)

// RuntimePanelView: the commands and files of one runtime; shown when its radio is checked (CodePanels).
templ RuntimePanelView(p RuntimePanel, intro string, json bool) {
	@block.Block(block.BlockProps{Tag: "section", ID: p.ID, Class: "rt-panel", Attrs: templ.Attributes{"data-runtime": p.Runtime, "aria-label": Tf("code.of", p.Label)}}) {
		@text.Text(text.TextProps{Size: "sm", Class: "mb-2 text-muted-foreground"}) {
			{ intro }
		}
		@box.Box(box.BoxProps{Class: "mb-2"}) {
			@Command(p.ID+"-init", p.InstallInit)
		}
		@box.Box(box.BoxProps{Class: "mb-4"}) {
			@Command(p.ID+"-add", p.InstallAdd)
		}
		for _, f := range p.Files {
			@CodeFileView(f)
		}
		if json {
			@text.Text(text.TextProps{Size: "sm"}) {
				@linkplain.LinkPlain(linkplain.LinkPlainProps{Href: p.JSONHref, Class: "underline"}) {
					{ Tf("item.json", p.Label) }
				}
			}
		}
	}
}
